# Dependencies (Vitest lands in WP1; the shipped app has none)
node_modules/

# Secrets — the YouTube API key never enters the repo
.env
.env.*
*.local
# Local dev convenience: your own key, pre-filled into the Live API field.
# Matches in any directory; never committed, never shipped.
config.local.js

# External / working notes (GPT dumps, scratch rationale) — not part of the repo
external-docs/
# Parked research notes — kept locally, out of the repo
Future/

# Claude Code personal settings (machine-local, not for the repo)
.claude/settings.local.json

# Editor / OS cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Test / build output — reports are generated on demand, never committed
coverage/
reports/
# The assembled deployable site. Built locally by tools/build-site.js and uploaded
# straight to the CDN, so it never belongs in git — it carries the built sets.
_site/

# Magic Search output — generated sets carry real creator data; never committed
# (see DECISIONS.md: build first, legality before deploying to real users).
sets/*.draft.json
# Built sets — full creator stats, minted by tools/build-set.js and rebuilt locally
# on the 25-day cadence. NEVER committed: a set file in git is permanent,
# which would break both the 30-day cap on stored statistics and the promise that a
# removal request is actually performable (git rm leaves them at the old commit).
sets/built/
# Dev-only picker manifest that surfaces generated drafts in the Sets dropdown.
sets/index.local.json

# Local Netlify folder
.netlify
